@startuml diagramme_sequence

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBackgroundColor #f0f0f0

title Lot 1.1 — Scénarios de test addMember()

== Scénario 1 : BadEntryException (paramètres invalides) ==

participant ":AddMemberTest" as test
participant ":SocialNetwork" as sn

test -> sn : new SocialNetwork()
activate sn

test -> sn : addMember(null, "qsdfgh", "")
activate sn
sn --> test : throws BadEntryException
deactivate sn

test -> sn : nbMembers()
sn --> test : 0

note right of test
  Vérifié : nbMembers() inchangé
  après chaque BadEntryException
  (idem pour les cas 1.2 à 1.5)
end note

test -> sn : addMember(" ", "qsdfgh", "")
activate sn
sn --> test : throws BadEntryException
deactivate sn

test -> sn : addMember("B", null, "")
activate sn
sn --> test : throws BadEntryException
deactivate sn

test -> sn : addMember("B", "   qwd ", "")
activate sn
sn --> test : throws BadEntryException
deactivate sn

test -> sn : addMember("BBBB", "bbbb", null)
activate sn
sn --> test : throws BadEntryException
deactivate sn

== Scénario 2 : Ajout nominal + MemberAlreadyExistsException ==

test -> sn : addMember("Paul", "paul", "lecteur impulsif")
activate sn
sn --> test : [void]
deactivate sn
test -> sn : nbMembers()
sn --> test : 1

test -> sn : addMember("Antoine", "antoine", "grand amoureux de la littérature")
activate sn
sn --> test : [void]
deactivate sn
test -> sn : nbMembers()
sn --> test : 2

test -> sn : addMember("Alice", "alice", "passionnée de bande dessinée")
activate sn
sn --> test : [void]
deactivate sn
test -> sn : nbMembers()
sn --> test : 3

test -> sn : addMember("Paul", "abcdefghij", "")
activate sn
sn --> test : throws MemberAlreadyExistsException
deactivate sn

test -> sn : addMember("anToine", "abcdefghij", "")
activate sn
note right of sn
  Comparaison insensible à la casse
  et sans leading/trailing blanks
end note
sn --> test : throws MemberAlreadyExistsException
deactivate sn

test -> sn : addMember(" Antoine ", "abcdefghij", "")
activate sn
sn --> test : throws MemberAlreadyExistsException
deactivate sn

test -> sn : nbMembers()
sn --> test : 3

note right of test
  Vérifié : nbMembers() inchangé
  après chaque MemberAlreadyExistsException
end note

deactivate sn

@enduml
